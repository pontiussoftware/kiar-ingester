# Copy to .env and adjust. All variables are optional; the defaults keep everything below ./data.

# Host port the dashboard and API are published on.
KIAR_PORT=7070

# UID/GID the application runs as inside the container. Use the owner of the mapped folders (id -u / id -g).
KIAR_UID=1000
KIAR_GID=1000

# Image tag.
KIAR_VERSION=latest

# Host folders mapped into the container.
KIAR_CONFIG_DIR=./data/config
KIAR_DB_DIR=./data/db
KIAR_INGEST_DIR=./data/ingest
KIAR_LOG_DIR=./data/logs
KIAR_MEDIA_DIR=./data/media

# JVM options. The default sizes the heap relative to the container memory limit.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# Used only when config.json is generated on first start.
KIAR_JOB_LOG_RETENTION_DAYS=30
KIAR_INPUT_RETENTION_COUNT=1
